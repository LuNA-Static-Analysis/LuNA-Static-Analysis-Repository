{
  "arrange": [],
  "act": {
    "command": "adapt --run prolog main.fa",
    "can_fail": false
  },
  "assert": {
    "stdout": {
      "match_lines": [
        "wc:Found 5 error*",
        "wc:warning[SEM3.1W]*x[-1]",
        "wc:warning[SEM3.1W]*x[11]",
        "wc:warning[SEM3.1W]*x[N]",
        "wc:warning[SEM3.1W]*y[1]",
        "wc:warning[SEM3.1W]*y[N]",
        "wc:when *x*>*0*"
      ]
    },
    "stderr": {
      "empty": true
    },
    "save": ["stderr", "stdout"]
  }
}
