C++ sub set_int(name x, int v) ${{ x = v; $}}
C++ sub print(int v) ${{ printf("%d\n", v); $}}

// Using info from prolog-analyzer luna-hybrid-debugger should
// 1. Generate 2 loop bound checks (DF z is OK according to prolog-analyzer)
// 2. Find 1 loop bound mismatch at runtime (DF x)
// 3. Output an error for DF x instead of a warning from prolog-analyzer
// 4. Keep a warning from prolog-analyzer for DF y

sub main() {
    df x, y, z, N, M;

    set_int(N, 10);
    set_int(M, 11);

    for i = 1..N {
        set_int(x[i], i);
    }

    // Error: M > N
    for i = 1..M {
        print(x[i]);
    }

    for j = 1..N {
        set_int(y[j], j);
    }

    // Ok: M-1 <= N (only known at runtime)
    for j = 1..M-1 {
        print(y[j]);
    }

    for k = 1..N {
        set_int(z[k], k);
    }

    // Ok: N-1 <= N (known at compile time)
    for k = 1..N-1 {
        print(z[k]);
    }
}