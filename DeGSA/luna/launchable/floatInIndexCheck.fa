import c_init_float(real, name) as initFloat;
import printfl(real) as print;
sub main(){
        df a;
        initFloat(1.5, a);
        //initFloat(2.5, a[a]);// crashes even if not used, dynamic_cast<int>(real)
        initFloat(2.5, a[1.5]);// equals to a[1], static cast as in 0.1 = 0.5 = 0.9 = 0
        print(a); // ok, 1.5
        print(a[1]); // ok, 2.5
}
